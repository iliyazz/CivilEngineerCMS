@using CivilEngineerCMS.Services.Data.Interfaces;
@using CivilEngineerCMS.Web.Infrastructure.Extensions;
@inject IEmployeeService EmployeeService;
@inject IAdministratorService AdministratorService;
@{
    ViewData["Title"] = L["Admin Dashboard"].Value;
    bool isEmployee = await EmployeeService.IsEmployeeAsync(User.GetId());
}

<div class="page-header">
    <h2><i class="bi bi-shield-check me-2"></i>@L["Administrator Dashboard"]</h2>
    <p>@L["Welcome back! Manage all projects, employees, clients, and system settings from here."]</p>
</div>

<!-- Quick Actions -->
<div class="mb-4">
    <div class="section-header">
        <h4><i class="bi bi-grid me-2"></i>@L["Quick Actions"]</h4>
    </div>
    <div class="action-grid">
        <a class="action-item" asp-area="Admin" asp-controller="Administrator" asp-action="ManageAdministrators">
            <i class="bi bi-people-fill"></i>
            <span>@L["Manage Admins"]</span>
        </a>
        <a class="action-item" asp-area="Admin" asp-controller="Project" asp-action="All">
            <i class="bi bi-folder2-open"></i>
            <span>@L["All Projects"]</span>
        </a>
        <a class="action-item" asp-area="Admin" asp-controller="Employee" asp-action="All">
            <i class="bi bi-person-badge"></i>
            <span>@L["All Employees"]</span>
        </a>
        <a class="action-item" asp-area="Admin" asp-controller="Client" asp-action="All">
            <i class="bi bi-briefcase"></i>
            <span>@L["All Clients"]</span>
        </a>
        <a class="action-item" asp-area="" asp-controller="Employee" asp-action="Create">
            <i class="bi bi-person-plus"></i>
            <span>@L["Add Employee"]</span>
        </a>
        <a class="action-item" asp-area="" asp-controller="Client" asp-action="Create">
            <i class="bi bi-person-vcard"></i>
            <span>@L["Add Client"]</span>
        </a>
        <a class="action-item" asp-area="" asp-controller="Project" asp-action="Add">
            <i class="bi bi-plus-circle"></i>
            <span>@L["New Project"]</span>
        </a>
        @if (isEmployee)
        {
            <a class="action-item" asp-area="" asp-controller="Employee" asp-action="Mine">
                <i class="bi bi-diagram-3"></i>
                <span>@L["Manager Projects"]</span>
            </a>
            <a class="action-item" asp-area="" asp-controller="Employee" asp-action="MineByEmployeeId">
                <i class="bi bi-person-workspace"></i>
                <span>@L["My Projects"]</span>
            </a>
        }
    </div>
</div>

<!-- Statistics -->
<div class="section-header">
    <h4><i class="bi bi-bar-chart me-2"></i>@L["System Statistics"]</h4>
</div>
<div class="text-center mb-3">
    <button class="buttonStatistic" id="statistics_btn"
            data-show-text="@L["Show statistics"]" data-hide-text="@L["Hide statistics"]">
        <i class="bi bi-graph-up me-2"></i>@L["Load Statistics"]
    </button>
</div>
<div class="d-none" id="statistics_box">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-label"><i class="bi bi-folder2 me-1"></i>@L["Total Projects"]</div>
                <div class="stat-value" id="total_projects">—</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card" style="border-left-color:var(--success);">
                <div class="stat-label"><i class="bi bi-activity me-1"></i>@L["Active Projects"]</div>
                <div class="stat-value" style="color:var(--success);" id="total_active_projects">—</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card" style="border-left-color:var(--accent);">
                <div class="stat-label"><i class="bi bi-people me-1"></i>@L["Total Clients"]</div>
                <div class="stat-value" style="color:var(--accent);" id="total_clients">—</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>statistics();</script>
}

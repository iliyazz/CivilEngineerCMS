@using CivilEngineerCMS.Services.Data.Interfaces
@using CivilEngineerCMS.Web.Infrastructure.Middlewares
@model IEnumerable<CivilEngineerCMS.Web.ViewModels.Client.AllClientViewModel>
@inject IClientService ClientService
@{
    ViewData["Title"] = "All Clients";
    var clients = Model.ToList();
}

<div class="page-header">
    <h2><i class="bi bi-briefcase me-2"></i>All Clients</h2>
    <p>Overview of all registered clients and their online status.</p>
    <div class="page-header-actions">
        <a class="btn btn-success btn-sm" asp-area="" asp-controller="Client" asp-action="Create">
            <i class="bi bi-person-vcard me-1"></i>Add Client
        </a>
    </div>
</div>

@if (!clients.Any())
{
    <div class="empty-state">
        <span class="empty-icon"><i class="bi bi-briefcase"></i></span>
        <h4>No clients registered</h4>
        <p>Add the first client to get started.</p>
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge-status badge-active">
            <i class="bi bi-wifi me-1"></i>@OnLineUsersMiddleware.GetOnLineUsersCount() online now
        </span>
    </div>
    <div class="table-wrapper">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNumber = 0; }
                @foreach (var cl in clients)
                {
                    rowNumber++;
                    <tr onclick="location.href='@Url.Action("Details", "Client", new { id = cl.Id.ToString(), area = "" })'">
                        <td class="fw-600">@rowNumber</td>
                        <td>@cl.FirstName</td>
                        <td>@cl.LastName</td>
                        <td>@cl.PhoneNumber</td>
                        <td>@cl.Email</td>
                        <td>@cl.Address</td>
                        <td class="text-center">
                            @if (cl.IsActive)
                            {
                                <span class="badge-status badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-cancelled">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (OnLineUsersMiddleware.CheckIfUserIsOnline(cl.UserId.ToString()))
                            {
                                <span class="badge-online"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Online</span>
                            }
                            else
                            {
                                <span class="badge-offline">Offline</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

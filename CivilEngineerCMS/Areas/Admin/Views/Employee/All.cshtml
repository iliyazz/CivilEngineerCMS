@using CivilEngineerCMS.Services.Data.Interfaces
@using CivilEngineerCMS.Web.Infrastructure.Middlewares
@model IEnumerable<CivilEngineerCMS.Web.ViewModels.Employee.AllEmployeeViewModel>
@inject IEmployeeService EmployeeService
@{
    ViewData["Title"] = L["All Employees"].Value;
    var employees = Model.ToList();
}

<div class="page-header">
    <h2><i class="bi bi-person-badge me-2"></i>@L["All Employees"]</h2>
    <p>@L["Overview of all registered employees and their online status."]</p>
    <div class="page-header-actions">
        <a class="btn btn-success btn-sm" asp-area="" asp-controller="Employee" asp-action="Create">
            <i class="bi bi-person-plus me-1"></i>@L["Add Employee"]
        </a>
    </div>
</div>

@if (!employees.Any())
{
    <div class="empty-state">
        <span class="empty-icon"><i class="bi bi-person-badge"></i></span>
        <h4>@L["No employees registered"]</h4>
        <p>@L["Add the first employee to get started."]</p>
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge-status badge-active">
            <i class="bi bi-wifi me-1"></i>@L["{0} online now", OnLineUsersMiddleware.GetOnLineUsersCount()]
        </span>
    </div>
    <div class="table-wrapper">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["First Name"]</th>
                    <th>@L["Last Name"]</th>
                    <th>@L["Job Title"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Phone"]</th>
                    <th class="text-center">@L["Active"]</th>
                    <th class="text-center">@L["Status"]</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNumber = 0; }
                @foreach (var em in employees)
                {
                    rowNumber++;
                    <tr onclick="location.href='@Url.Action("Details", "Employee", new { id = em.Id, area = "" })'">
                        <td class="fw-600">@rowNumber</td>
                        <td>@em.FirstName</td>
                        <td>@em.LastName</td>
                        <td>@em.JobTitle</td>
                        <td>@em.Email</td>
                        <td>@em.PhoneNumber</td>
                        <td class="text-center">
                            @if (em.IsActive)
                            {
                                <span class="badge-status badge-active">@L["Active"]</span>
                            }
                            else
                            {
                                <span class="badge-status badge-cancelled">@L["Inactive"]</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (OnLineUsersMiddleware.CheckIfUserIsOnline(em.UserId.ToString()))
                            {
                                <span class="badge-online"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>@L["Online"]</span>
                            }
                            else
                            {
                                <span class="badge-offline">@L["Offline"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

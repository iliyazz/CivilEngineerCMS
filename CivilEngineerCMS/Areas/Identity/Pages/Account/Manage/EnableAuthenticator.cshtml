@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = L["Configure authenticator app"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>@L["To use an authenticator app go through the following steps:"]</p>
    <ol class="list">
        <li>
            <p>
                @L["Download a two-factor authenticator app like Microsoft Authenticator for <a href=\"{0}\">Android</a> and <a href=\"{1}\">iOS</a> or Google Authenticator for <a href=\"{2}\">Android</a> and <a href=\"{3}\">iOS</a>.",
                    "https://go.microsoft.com/fwlink/?Linkid=825072", "https://go.microsoft.com/fwlink/?Linkid=825073",
                    "https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2", "https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8"]
            </p>
        </li>
        <li>
            <p>@L["Scan the QR Code or enter this key <kbd>{0}</kbd> into your two factor authenticator app. Spaces and casing do not matter.", Model.SharedKey]</p>
            <div class="alert alert-info">@L["Learn how to <a href=\"{0}\">enable QR code generation</a>.", "https://go.microsoft.com/fwlink/?Linkid=852423"]</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                @L["Once you have scanned the QR code or input the key above, your two factor authentication app will provide you with a unique code. Enter the code in the confirmation box below."]
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="@L["Please enter the code."]"/>
                            <label asp-for="Input.Code" class="control-label form-label">@L["Verification Code"]</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Verify"]</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

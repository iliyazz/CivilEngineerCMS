@model AddAndEditExpensesFormModel
@{
    ViewData["Title"] = L["Add Expense"].Value;
}

<div class="page-header">
    <h2><i class="bi bi-plus-circle me-2"></i>@L["Add Expense"]</h2>
    <p>@L["Record a new financial entry for this project."]</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-currency-euro me-2"></i>@L["Expense Details"]
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="form-group">
                        <label class="form-label" asp-for="Amount">
                            <i class="bi bi-cash-stack me-1"></i>@L["Paid Amount (€)"]
                        </label>
                        <input asp-for="Amount" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="TotalAmount">
                            <i class="bi bi-calculator me-1"></i>@L["Total Required (€)"]
                        </label>
                        <input asp-for="TotalAmount" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <a class="btn btn-outline-secondary" href="javascript:history.back();">
                            <i class="bi bi-x me-1"></i>@L["Cancel"]
                        </a>
                        <input class="btn btn-primary" type="submit" value="@L["Save Expense"]" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

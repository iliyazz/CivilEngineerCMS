@model IEnumerable<MineClientManagerProjectViewModel>
@{
    ViewData["Title"] = L["My Projects"].Value;
    var projects = Model.ToList();
}

<div class="page-header">
    <h2><i class="bi bi-collection me-2"></i>@L["My Projects"]</h2>
    <p>@L["Projects assigned to you as the client."]</p>
</div>

@if (!projects.Any())
{
    <div class="empty-state">
        <span class="empty-icon"><i class="bi bi-folder2-open"></i></span>
        <h4>@L["No projects yet"]</h4>
        <p>@L["No projects have been assigned to you yet."]</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["Project Title"]</th>
                    <th>@L["Manager"]</th>
                    <th>@L["Manager Phone"]</th>
                    <th>@L["Start Date"]</th>
                    <th>@L["End Date"]</th>
                    <th class="text-center">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNumber = 0; }
                @foreach (var p in projects)
                {
                    rowNumber++;
                    <tr>
                        <td class="fw-600">@rowNumber</td>
                        <td class="fw-600">@p.ProjectName</td>
                        <td>@p.ManagerName</td>
                        <td>@p.ManagerPhoneNumber</td>
                        <td>@p.ProjectCreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>@p.ProjectEndDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center">
                                <a class="btn btn-primary btn-sm"
                                   asp-area="" asp-controller="Expense" asp-action="Details" asp-route-id="@p.ProjectId">
                                    <i class="bi bi-currency-euro me-1"></i>@L["Expenses"]
                                </a>
                                <a class="btn btn-info btn-sm"
                                   asp-area="" asp-controller="Interaction" asp-action="All" asp-route-id="@p.ProjectId">
                                    <i class="bi bi-chat-dots me-1"></i>@L["Interactions"]
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

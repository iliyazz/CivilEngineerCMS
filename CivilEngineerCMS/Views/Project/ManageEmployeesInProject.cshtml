@model IEnumerable<SelectEmployeesForProjectFormModel>
@{
    ViewData["Title"] = L["Manage Project Team"].Value;
}

<div class="page-header">
    <h2><i class="bi bi-people-fill me-2"></i>@L["Manage Project Team"]</h2>
    <p>@L["Check or uncheck employees to add or remove them from this project."]</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-check2-square me-2"></i>@L["Select Team Members"]
            </div>
            <div class="card-body p-0">
                <form method="post">
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <span class="empty-icon"><i class="bi bi-people"></i></span>
                            <h4>@L["No employees available"]</h4>
                            <p>@L["No active employees found in the system."]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper" style="border-radius:0;">
                            <table class="table table-hover checkbox-table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>@L["First Name"]</th>
                                        <th>@L["Last Name"]</th>
                                        <th>@L["Job Title"]</th>
                                        <th>@L["Phone"]</th>
                                        <th class="text-center">@L["In Project"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int rowNumber = 0; }
                                    @foreach (var e in Model)
                                    {
                                        rowNumber++;
                                        <tr>
                                            <td class="fw-600">@rowNumber</td>
                                            <td>@e.FirstName</td>
                                            <td>@e.LastName</td>
                                            <td>@e.JobTitle</td>
                                            <td>@e.PhoneNumber</td>
                                            <td class="text-center">
                                                <input type="checkbox" asp-for="@e.IsChecked"
                                                       id="@e.Id" name="selectedEmployee" value="@e.Id"
                                                       class="form-check-input" style="width:1.2em;height:1.2em;" />
                                                <input type="hidden" asp-for="@e.Id" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="p-3 d-flex gap-2 justify-content-end border-top">
                        <a class="btn btn-outline-secondary" href="javascript:history.back();">
                            <i class="bi bi-x me-1"></i>@L["Cancel"]
                        </a>
                        <input class="btn btn-primary" type="submit" value="@L["Save Team"]" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

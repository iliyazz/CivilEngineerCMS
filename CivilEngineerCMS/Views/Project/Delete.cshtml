@model ProjectPreDeleteViewModel
@{
    ViewData["Title"] = "Delete Project";
}

<div class="page-header" style="background:linear-gradient(135deg,#7f1d1d,#b91c1c);">
    <h2><i class="bi bi-trash me-2"></i>Delete Project</h2>
    <p>Please review the project details before permanently deleting.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0" style="border-left:4px solid var(--danger) !important;box-shadow:var(--shadow-md);">
            <div class="card-body">
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>This action is <strong>permanent</strong> and cannot be undone.</span>
                </div>

                <form method="post" asp-action="Delete">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Status" class="form-label"></label>
                        <input asp-for="Status" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ProjectStartDate" class="form-label"></label>
                        <input asp-for="ProjectStartDate" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ProjectEndDate" class="form-label"></label>
                        <input asp-for="ProjectEndDate" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ManagerName" class="form-label"></label>
                        <input asp-for="ManagerName" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ClientName" class="form-label"></label>
                        <input asp-for="ClientName" class="form-control" disabled="disabled" />
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <input type="submit" value="Delete Project" class="btn btn-danger"
                               onclick="return confirm('Are you sure you want to permanently delete this project?')" />
                        <a class="btn btn-outline-secondary" href="javascript:history.back();">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

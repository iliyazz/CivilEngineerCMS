@using CivilEngineerCMS.Services.Data.Interfaces
@using CivilEngineerCMS.Web.Infrastructure.Extensions
@model DetailsProjectViewModel
@inject IEmployeeService EmployeesService
@inject IProjectService ProjectService
@inject IClientService ClientService
@{
    ViewData["Title"] = L["Project Details"].Value;
    string userId = User.GetId();
    bool isManagerInProject = false;
    bool isAdministrator = this.User.IsAdministrator();
    bool isEmployee = await EmployeesService.IsEmployeeAsync(userId);
    bool isClient = await ClientService.IsClientByUserIdAsync(userId);

    if (isEmployee)
    {
        string employeeId = await EmployeesService.GetEmployeeIdByUserIdAsync(userId);
        string managerId = await ProjectService.GetManagerIdByProjectIdAsync(Model.Id.ToString());
        isManagerInProject = employeeId == managerId;
    }
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-folder2-open me-2"></i>@Model.Name</h2>
            <p class="mb-0">@Model.Description</p>
        </div>
    </div>
    <div class="page-header-actions">
        @if (isManagerInProject || isAdministrator)
        {
            <a class="btn btn-warning btn-sm" asp-area="" asp-controller="Project" asp-action="Edit" asp-route-id="@Model.Id.ToString()">
                <i class="bi bi-pencil me-1"></i>@L["Edit"]
            </a>
            <a class="btn btn-danger btn-sm" asp-area="" asp-controller="Project" asp-action="Delete" asp-route-id="@Model.Id.ToString()">
                <i class="bi bi-trash me-1"></i>@L["Delete"]
            </a>
            <a class="btn btn-warning btn-sm" asp-area="" asp-controller="Project" asp-action="ManageEmployeesInProject" asp-route-id="@Model.Id.ToString()">
                <i class="bi bi-people me-1"></i>@L["Manage team"]
            </a>
            <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Expense" asp-action="Details" asp-route-id="@Model.Id.ToString()">
                <i class="bi bi-currency-euro me-1"></i>@L["Expenses"]
            </a>
        }
        <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Interaction" asp-action="All" asp-route-id="@Model.Id.ToString()">
            <i class="bi bi-chat-dots me-1"></i>@L["Interactions"]
        </a>
        @if (isAdministrator)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-area="Admin" asp-controller="Project" asp-action="All">
                <i class="bi bi-arrow-left me-1"></i>@L["All Projects"]
            </a>
        }
        else if (isManagerInProject)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Employee" asp-action="Mine">
                <i class="bi bi-arrow-left me-1"></i>@L["Back"]
            </a>
        }
        else if (isEmployee)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Employee" asp-action="MineByEmployeeId">
                <i class="bi bi-arrow-left me-1"></i>@L["Back"]
            </a>
        }
        else if (isClient)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Client" asp-action="Mine">
                <i class="bi bi-arrow-left me-1"></i>@L["Back"]
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Project Image -->
        @if (!string.IsNullOrWhiteSpace(Model.UrlPicturePath))
        {
            <div class="mb-4">
                <img src="@Model.UrlPicturePath" alt="@Model.ImageName" class="project-img" />
            </div>
        }

        <!-- Project Info -->
        <div class="detail-grid">
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-activity me-1"></i>@L["Status"]</div>
                <div class="di-value">@L[Model.Status.GetDisplayName()]</div>
            </div>
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-calendar-check me-1"></i>@L["Start Date"]</div>
                <div class="di-value">@Model.ProjectStartDate</div>
            </div>
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-calendar-x me-1"></i>@L["End Date"]</div>
                <div class="di-value">@Model.ProjectEndDate</div>
            </div>
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-person-badge me-1"></i>@L["Manager"]</div>
                <div class="di-value">@Model.ManagerName</div>
            </div>
        </div>

        <!-- Employees Table -->
        <div class="section-header">
            <h4><i class="bi bi-people me-2"></i>@L["Project Team"]</h4>
            <span class="badge bg-secondary">@L["{0} members", Model.Employees.Count()]</span>
        </div>

        @if (!Model.Employees.Any())
        {
            <div class="empty-state py-4">
                <span class="empty-icon"><i class="bi bi-people"></i></span>
                <h4>@L["No team members assigned"]</h4>
                @if (isManagerInProject || isAdministrator)
                {
                    <p>@L["Use <strong>Manage Team</strong> to add employees to this project."]</p>
                }
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["First Name"]</th>
                            <th>@L["Last Name"]</th>
                            <th>@L["Job Title"]</th>
                            <th>@L["Phone"]</th>
                            <th>@L["Email"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNumber = 0; }
                        @foreach (var e in Model.Employees)
                        {
                            rowNumber++;
                            <tr style="cursor:default;">
                                <td class="fw-600">@rowNumber</td>
                                <td>@e.FirstName</td>
                                <td>@e.LastName</td>
                                <td><span class="badge-status badge-pending">@e.JobTitle</span></td>
                                <td>@e.PhoneNumber</td>
                                <td>@e.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Client Card -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-briefcase me-2"></i>@L["Client Information"]
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="di-label">@L["Name"]</div>
                    <div class="di-value">@Model.ClientName</div>
                </div>
                <div class="mb-3">
                    <div class="di-label">@L["Phone"]</div>
                    <div class="di-value">@Model.ClientPhone</div>
                </div>
                <div>
                    <div class="di-label">@L["Email"]</div>
                    <div class="di-value">@Model.ClientEmail</div>
                </div>
            </div>
        </div>
    </div>
</div>

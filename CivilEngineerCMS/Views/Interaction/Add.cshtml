@model AddAndEditInteractionFormModel
@{
    ViewData["Title"] = L["Add Interaction"].Value;
}

<div class="page-header">
    <h2><i class="bi bi-chat-plus me-2"></i>@L["Add Interaction"]</h2>
    <p>@L["Log a new communication or interaction for this project."]</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-chat-square-text me-2"></i>@L["Interaction Details"]
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="form-group">
                        <label class="form-label" asp-for="Type">
                            <i class="bi bi-tag me-1"></i>@L["Type"]
                        </label>
                        <input asp-for="Type" class="form-control" placeholder="@L["e.g. Meeting, Email, Call..."]" />
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Description">
                            <i class="bi bi-card-text me-1"></i>@L["Description"]
                        </label>
                        <input asp-for="Description" class="form-control" placeholder="@L["Brief description..."]" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Message">
                            <i class="bi bi-chat-left-text me-1"></i>@L["Message"]
                        </label>
                        <input asp-for="Message" class="form-control" placeholder="@L["Interaction message or notes..."]" />
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="UrlPath">
                            <i class="bi bi-link-45deg me-1"></i>@L["File Link (optional)"]
                        </label>
                        <input asp-for="UrlPath" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="UrlPath" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <a class="btn btn-outline-secondary" href="javascript:history.back();">
                            <i class="bi bi-x me-1"></i>@L["Cancel"]
                        </a>
                        <input class="btn btn-primary" type="submit" value="@L["Save Interaction"]" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

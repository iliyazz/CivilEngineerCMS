@using CivilEngineerCMS.Services.Data.Interfaces
@using CivilEngineerCMS.Web.Infrastructure.Extensions
@model IEnumerable<CivilEngineerCMS.Web.ViewModels.Interaction.AddAndEditInteractionFormModel>
@inject IEmployeeService EmployeeService
@inject IProjectService ProjectService
@inject IClientService ClientService
@{
    ViewData["Title"] = L["Project Interactions"].Value;
    var interactions = Model.ToList();
    var isEmployee = await EmployeeService.IsEmployeeAsync(User.GetId());
    bool isEmployeeInProject = false;
    bool isManagerOfProject = false;
    bool isAdministrator = this.User.IsAdministrator();
    bool isClient = await ClientService.IsClientByUserIdAsync(User.GetId());
    if (isEmployee && interactions.Any())
    {
        var projectId = interactions.First().ProjectId.ToString();
        var employeeId = await EmployeeService.GetEmployeeIdByUserIdAsync(User.GetId());
        isEmployeeInProject = await EmployeeService.IsEmployeeInProjectAsync(projectId, employeeId);
        var managerId = await EmployeeService.GetManagerIdByUserIdAsync(User.GetId());
        isManagerOfProject = managerId != null && await ProjectService.IsManagerOfProjectAsync(projectId, managerId);
    }
}

<div class="page-header">
    <h2><i class="bi bi-chat-dots me-2"></i>@L["Project Interactions"]</h2>
    <p>@L["All interactions and communications logged for this project."]</p>
    <div class="page-header-actions">
        @if ((isEmployeeInProject || isManagerOfProject || isAdministrator) && interactions.Any())
        {
            <a class="btn btn-success btn-sm"
               asp-area="" asp-controller="Interaction" asp-action="Add" asp-route-id="@interactions.First().ProjectId.ToString()">
                <i class="bi bi-plus-lg me-1"></i>@L["Add Interaction"]
            </a>
            <a class="btn btn-outline-secondary btn-sm"
               asp-area="" asp-controller="Project" asp-action="Details" asp-route-id="@interactions.First().ProjectId.ToString()">
                <i class="bi bi-arrow-left me-1"></i>@L["Back to Project"]
            </a>
        }
        @if (isClient && interactions.Any())
        {
            <a class="btn btn-outline-secondary btn-sm"
               asp-area="" asp-controller="Client" asp-action="Mine">
                <i class="bi bi-arrow-left me-1"></i>@L["My Projects"]
            </a>
        }
    </div>
</div>

@if (!interactions.Any())
{
    <div class="empty-state">
        <span class="empty-icon"><i class="bi bi-chat-square-dots"></i></span>
        <h4>@L["No interactions yet"]</h4>
        <p>@L["No communications have been logged for this project."]</p>
        <a class="btn btn-outline-secondary" href="javascript:history.back();">
            <i class="bi bi-arrow-left me-1"></i>@L["Back"]
        </a>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["Date"]</th>
                    <th>@L["Type"]</th>
                    <th>@L["Description"]</th>
                    <th>@L["Message"]</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNumber = 0; }
                @foreach (var interaction in interactions)
                {
                    rowNumber++;
                    @if (isManagerOfProject || isAdministrator)
                    {
                        <tr onclick="location.href='@Url.Action("Edit", "Interaction", new { projectId = interaction.ProjectId.ToString(), interactionId = interaction.Id.ToString() })'">
                            <td class="fw-600">@rowNumber</td>
                            <td>@interaction.Date.ToString("dd.MM.yyyy")</td>
                            <td><span class="badge-status badge-pending">@interaction.Type</span></td>
                            <td>@interaction.Description</td>
                            <td>@interaction.Message</td>
                        </tr>
                    }
                    else
                    {
                        <tr style="cursor:default;">
                            <td class="fw-600">@rowNumber</td>
                            <td>@interaction.Date.ToString("dd.MM.yyyy")</td>
                            <td><span class="badge-status badge-pending">@interaction.Type</span></td>
                            <td>@interaction.Description</td>
                            <td>@interaction.Message</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@using static CivilEngineerCMS.Common.NotificationMessagesConstants;


@if (TempData.ContainsKey(ErrorMessage))
{
    <script>toastr.error(@Json.Serialize(TempData[ErrorMessage]));</script>
}
@if (TempData.ContainsKey(SuccessMessage))
{
    <script>toastr.success(@Json.Serialize(TempData[SuccessMessage]));</script>
}
@if (TempData.ContainsKey(InfoMessage))
{
    <script>toastr.info(@Json.Serialize(TempData[InfoMessage]));</script>
}
@if (TempData.ContainsKey(WarningMessage))
{
    <script>toastr.warning(@Json.Serialize(TempData[WarningMessage]));</script>
}

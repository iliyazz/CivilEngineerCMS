@{
    ViewData["Title"] = "Page Not Found";
}

<div class="error-wrapper">
    <div>
        <div class="error-code">404</div>
        <div class="error-message">
            <h2><i class="bi bi-search me-2 text-primary"></i>Page Not Found</h2>
            <p>The page you're looking for doesn't exist or has been moved.<br>Check the URL or return to the home page.</p>
            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>

@using CivilEngineerCMS.Services.Data.Interfaces
@using CivilEngineerCMS.Web.Infrastructure.Extensions
@model IEnumerable<IndexViewModel>
@inject IEmployeeService EmployeeService
@{
    ViewData["Title"] = L["Home"].Value;
    var projects = Model.ToList();
    string userId = User.GetId();
    bool isEmployee = await EmployeeService.IsEmployeeAsync(userId);
    bool isAdministrator = User.IsAdministrator();
}

@if (!isAdministrator)
{
    <div class="hero">
        <div class="hero-content">
            <h1><i class="bi bi-building-check me-2"></i>@L["Civil Engineer CMS"]</h1>
            <p class="lead">@L["Professional project management for civil engineering teams. Track projects, manage teams, and stay on schedule."]</p>
            @if (!(User.Identity?.IsAuthenticated ?? false))
            {
                <div class="d-flex gap-3 justify-content-center">
                    <a class="btn btn-warning btn-lg" asp-area="" asp-controller="User" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i>@L["Sign In"]
                    </a>
                    <a class="btn btn-lg" style="background:rgba(255,255,255,0.15);color:#fff;border:1.5px solid rgba(255,255,255,0.4);"
                       asp-area="" asp-controller="User" asp-action="Register">
                        <i class="bi bi-person-plus me-1"></i>@L["Register"]
                    </a>
                </div>
            }
        </div>
    </div>

    @if (projects.Any())
    {
        <div class="mb-4">
            <div class="section-header">
                <h4><i class="bi bi-images me-2"></i>@L["Featured Projects"]</h4>
            </div>
            <div class="carousel-wrapper">
                <div id="projectCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        @for (int i = 0; i < projects.Count; i++)
                        {
                            <button type="button" data-bs-target="#projectCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                    <div class="carousel-inner">
                        @for (int i = 0; i < projects.Count; i++)
                        {
                            var project = projects[i];
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                @if (!string.IsNullOrWhiteSpace(project.UrlPicturePath))
                                {
                                    <img src="@project.UrlPicturePath" class="d-block w-100"
                                         alt="@project.ImageName" style="max-height:480px;object-fit:cover;">
                                }
                                else
                                {
                                    <div style="height:300px;background:linear-gradient(135deg,#1e3a5f,#2d5a9e);display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-building" style="font-size:5rem;color:rgba(255,255,255,0.2);"></i>
                                    </div>
                                }
                                @if (isEmployee)
                                {
                                    <div class="carousel-caption">
                                        <h5>
                                            <a asp-area="" asp-controller="Project" asp-action="Details" asp-route-id="@project.Id">
                                                <i class="bi bi-arrow-right-circle me-1"></i>@project.Name
                                            </a>
                                        </h5>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#projectCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@L["Previous"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#projectCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@L["Next"]</span>
                    </button>
                </div>
            </div>
        </div>
    }
    else if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="empty-state">
            <span class="empty-icon"><i class="bi bi-folder2-open"></i></span>
            <h4>@L["No featured projects yet"]</h4>
            <p>@L["Projects with uploaded images will be showcased here."]</p>
        </div>
    }
}

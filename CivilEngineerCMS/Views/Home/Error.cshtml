@{
    ViewData["Title"] = "Error";
}

<div class="error-wrapper">
    <div>
        <div class="error-code">500</div>
        <div class="error-message">
            <h2><i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Something went wrong</h2>
            <p>An unexpected error occurred while processing your request.<br>Our team has been notified.</p>
            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>

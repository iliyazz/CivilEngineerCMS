@{
    ViewData["Title"] = L["Error"].Value;
}

<div class="error-wrapper">
    <div>
        <div class="error-code">500</div>
        <div class="error-message">
            <h2><i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@L["Something went wrong"]</h2>
            <p>@L["An unexpected error occurred while processing your request."]<br>@L["Our team has been notified."]</p>
            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-1"></i>@L["Back to Home"]
            </a>
        </div>
    </div>
</div>

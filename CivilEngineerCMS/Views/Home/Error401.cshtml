@{
    ViewData["Title"] = "Access Denied";
}

<div class="error-wrapper">
    <div>
        <div class="error-code">401</div>
        <div class="error-message">
            <h2><i class="bi bi-shield-lock-fill me-2 text-danger"></i>Access Denied</h2>
            <p>You don't have permission to view this page.<br>Please log in with an authorised account.</p>
            <a class="btn btn-primary btn-lg me-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-1"></i>Back to Home
            </a>
            <a class="btn btn-outline-primary btn-lg" asp-area="" asp-controller="User" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </a>
        </div>
    </div>
</div>

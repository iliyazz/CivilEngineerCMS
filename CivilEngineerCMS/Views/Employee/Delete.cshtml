@model EmployeePreDeleteViewModel
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="page-header" style="background:linear-gradient(135deg,#7f1d1d,#b91c1c);">
    <h2><i class="bi bi-person-x me-2"></i>Delete Employee</h2>
    <p>Review the employee details before permanently deleting their record.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>This action is <strong>permanent</strong> and cannot be undone.</span>
                </div>

                <form method="post" asp-action="Delete">
                    <div class="form-group">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="JobTitle" class="form-label"></label>
                        <input asp-for="JobTitle" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" disabled="disabled" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" disabled="disabled" />
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <input type="submit" value="Delete Employee" class="btn btn-danger" />
                        <a class="btn btn-outline-secondary" href="javascript:history.back();">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

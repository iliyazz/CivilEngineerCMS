@model DetailsEmployeeViewModel
@{
    ViewData["Title"] = L["Employee Details"].Value;
}

<div class="page-header">
    <h2><i class="bi bi-person-badge me-2"></i>@Model.FirstName @Model.LastName</h2>
    <p><i class="bi bi-briefcase me-1"></i>@Model.JobTitle</p>
    <div class="page-header-actions">
        <a class="btn btn-warning btn-sm" asp-area="" asp-controller="Employee" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil me-1"></i>@L["Edit"]
        </a>
        <a class="btn btn-danger btn-sm" asp-area="" asp-controller="Employee" asp-action="Delete" asp-route-id="@Model.Id">
            <i class="bi bi-trash me-1"></i>@L["Delete"]
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="javascript:history.back();">
            <i class="bi bi-arrow-left me-1"></i>@L["Back"]
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="detail-grid">
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-briefcase me-1"></i>@L["Job Title"]</div>
                <div class="di-value">@Model.JobTitle</div>
            </div>
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-envelope me-1"></i>@L["Email"]</div>
                <div class="di-value">@Model.Email</div>
            </div>
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-telephone me-1"></i>@L["Phone"]</div>
                <div class="di-value">@Model.PhoneNumber</div>
            </div>
            <div class="detail-item">
                <div class="di-label"><i class="bi bi-geo-alt me-1"></i>@L["Address"]</div>
                <div class="di-value">@Model.Address</div>
            </div>
        </div>
    </div>
</div>

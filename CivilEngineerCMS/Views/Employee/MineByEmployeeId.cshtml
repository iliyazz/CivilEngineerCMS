@model IEnumerable<MineManagerProjectViewModel>
@{
    ViewData["Title"] = "My Employee Projects";
    var projects = Model.ToList();
}

<div class="page-header">
    <h2><i class="bi bi-person-workspace me-2"></i>My Employee Projects</h2>
    <p>Projects you are assigned to as a team member.</p>
</div>

@if (!projects.Any())
{
    <div class="empty-state">
        <span class="empty-icon"><i class="bi bi-folder2-open"></i></span>
        <h4>No projects yet</h4>
        <p>You haven't been assigned to any projects as an employee.</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Project Title</th>
                    <th>Client</th>
                    <th>Client Phone</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNumber = 0; }
                @foreach (var p in projects)
                {
                    rowNumber++;
                    <tr onclick="location.href='@Url.Action("Details", "Project", new { id = p.Id })'">
                        <td class="fw-600">@rowNumber</td>
                        <td class="fw-600">@p.ProjectName</td>
                        <td>@p.ClientName</td>
                        <td>@p.ClientPhoneNumber</td>
                        <td>@p.ProjectCreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>@p.ProjectEndDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center" onclick="event.stopPropagation();">
                            <a class="btn btn-primary btn-sm"
                               asp-area="" asp-controller="Project" asp-action="Details" asp-route-id="@p.Id">
                                <i class="bi bi-eye me-1"></i>Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
